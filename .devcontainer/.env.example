# Host-specific Compose values. Copy to .devcontainer/.env (git-ignored) and
# uncomment what this host needs. Never put credentials here.

# Bring the container back after a host reboot (default: no restart).
# RESTART_POLICY=unless-stopped

# The host user's IDs, when they are not 1000, so `app` owns the mounted files.
# RAMIFY_UID=1000
# RAMIFY_GID=1000
