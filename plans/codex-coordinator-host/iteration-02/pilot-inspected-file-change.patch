+/** Format elapsed whole seconds as HH:MM:SS. */
+export function formatElapsed(seconds) {
+  if (!Number.isFinite(seconds) || seconds < 0) {
+    throw new RangeError("seconds must be a finite, non-negative number");
+  }
+
+  const wholeSeconds = BigInt(Math.floor(seconds));
+  const hours = wholeSeconds / 3600n;
+  const minutes = (wholeSeconds % 3600n) / 60n;
+  const remainingSeconds = wholeSeconds % 60n;
+  const twoDigits = (value) => value.toString().padStart(2, "0");
+
+  return `${twoDigits(hours)}:${twoDigits(minutes)}:${twoDigits(remainingSeconds)}`;
+}
