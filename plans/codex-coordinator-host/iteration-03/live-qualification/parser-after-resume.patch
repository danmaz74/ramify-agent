+/** Parse an elapsed label. */
+export function parseDuration(input) {
+  if (typeof input !== "string") {
+    throw new TypeError("duration label must be a string");
+  }
+
+  const match = /^([0-9]+):([0-5][0-9]):([0-5][0-9])$/.exec(input);
+  if (match === null || match[0].length !== input.length) {
+    throw new RangeError("invalid duration label");
+  }
+
+  const seconds = BigInt(match[1]) * 3600n + BigInt(match[2]) * 60n + BigInt(match[3]);
+  if (seconds > BigInt(Number.MAX_SAFE_INTEGER)) {
+    throw new RangeError("duration exceeds the maximum safe integer");
+  }
+  return Number(seconds);
+}
