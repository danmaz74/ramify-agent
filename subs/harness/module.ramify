// Relays of selected direct-child reading contracts, with recursive named
// companions. Existing CandidateSource and tree-operation relays stay below.
expose-sub CheckFindingAction, CheckFindingActionKind, CheckFindingActor, CheckFindingAwaiting, CheckFindingCounts, CheckFindingCredibility, CheckFindingDecision, CheckFindingDecisionId, CheckFindingEntry, CheckFindingGroup, CheckFindingId, CheckFindingIngestion, CheckFindingOwner, CheckFindingProducer, CheckFindingReason, CheckFindingRejection, CheckFindingRejectionCode, CheckFindingRelation, CheckFindingRepair, CheckFindingReport, CheckFindingReportId, CheckFindingRisk, CheckFindingSource, CheckFindingStanding, CheckFindingState, CheckFindingVerification, checkFindingActionSchema, checkFindingActorSchema, checkFindingAwaitingSchema, checkFindingCredibilitySchema, checkFindingDecisionIdSchema, checkFindingDecisionSchema, checkFindingIdSchema, checkFindingOwnerSchema, checkFindingProducerSchema, checkFindingReasonSchema, checkFindingRejectionCodeSchema, checkFindingRelationSchema, checkFindingRepairSchema, checkFindingReportIdSchema, checkFindingReportSchema, checkFindingSourceSchema, checkFindingStandingSchema, checkFindingVerificationSchema, checkFindingViewVersion from check-findings to descendants
// The owner-local alias preserves the original material-choice interface without
// colliding with the harness's distinct public wire contract.
expose-sub ReportedCheckFindingMaterialChoice, CheckFindingSummary, CheckFindingDetailView, CheckFindingListView, CheckFindingSelection, CheckFindingQueryInput, CheckFindingQuery, checkFindingQuerySchema, checkFindingQueryLimits, selectCheckFindings from check-findings to descendants
// GitLineRange binds evidence's original tuple without displacing agent LineRange.
expose-sub ChangeHistory, ChangedFile, GitLineRange, LineCommit, ModuleEntry, loadModuleTree from evidence to descendants
// Snapshot acquisition reads the evidence producer; no new executor or writer.
expose-sub readMeasurement, MeasurementRead, MeasurementDocument, ModuleMeasurement, documentSchema, moduleSchema, architectViewDirectory, RamifyCli, RamifyRun, RamifyCheckResult, CheckProvider, MaterializeResult, OwnershipQueryResult, OwnershipAnswer, OwnershipPath, RawOwnershipEvidence, ProviderFailureEvidence, RecoveryEvidence from evidence to descendants
expose-sub JsonLines, LedgerEntry, RecordBody, Transaction, readJsonLines from ledger to descendants
expose-sub Assessment, Candidate, ClosedRound, Outcome, Phase, RoundDecision, RoundDecisionInput, assessmentSchema, candidateSchema, decideNonfunctionalRound, roundSchema from nonfunctional to descendants
expose-sub DocumentManifest, ElementCatalog, PackageCitation, PackageDeviation, documentManifestSchema, elementCatalogSchema, elementKinds, packageCitationSchema, packageDeviationSchema from plan-evidence to descendants
expose-sub ScenarioId, ScenarioRecord, ScenarioState, ScenarioStates, scenarioIdSchema, scenarioRecordSchema, scenarioSourceHash, scenarioStateSchema from scenarios to descendants

// Temporary local guards forward to root enforcement in Plan 22 iteration 6.
expose-test guardedChildProcess, spawnAttempts from "helpers/process-guard.ts" to descendants

// Native request evidence is projected by its Pi owner. Root qualification
// reads validated plain artifacts; opaque continuation encoding stays in Pi.
expose-sub readPiNativeRequestArtifact, PiNativeRequestArtifact from agent to parent

// Exact setup-line attribution: the pure verifier the root's trial scripts
// run over their own collected Git facts, with the types its signature names,
// and the one guard every trial's evidence destination passes.
expose-src HarnessLineIdentities from "kpi/delivered.ts" to parent
expose-src verifySetupLineIdentities, SetupLineIdentityInput, SetupCandidatePartition, RecordedSetupDelta from "kpi/setup-attribution.ts" to parent
expose-src SetupSourceLine, SetupLineMappingFacts, SetupAddedLineFact, SetupDeletedLineFact from "kpi/setup-attribution.ts" to parent
expose-src trialReportDestination from "kpi/trial-report.ts" to parent

// Production ledger reopening belongs to the descendant Pi native witness.
// Only the store contract and its signature companions cross this boundary.
expose-src openSessionStore, LedgerSessionStoreOptions, LedgerSessionStore from "run/session-store.ts" to descendants
expose-sub SessionStore, SessionStoreRecord, SessionStoreCommit, SessionStoreExpected, TranscriptPayloadId from agent to descendants

// Fixed live qualification owns its runtime; root receives plain options/results.
expose-src runPlan23LiveSession, Plan23LiveSessionOptions, Plan23LiveSessionResult from "qualification/live-session.ts" to parent

// Review evidence uses the existing candidate and tool ports through parent composition.
expose-sub CandidateSource, TreeEntry, TreeMatch, commitTree, treeEntries, readBlob, grepTree, diffPatch, diffNameStatus from evidence to descendants
expose-sub JsonSchema, ToolAction, ToolDefinition, ToolResult, LineRange from agent to descendants
expose-sub checkFindingIdSchema, checkFindingLocationSchema, checkFindingRiskSchema from check-findings to descendants
expose-sub deviationNotice from plan-evidence to descendants
expose-src schemaErrors, SubmissionError, SubmissionValidation from "run/submissions.ts" to descendants
expose-src canonicalJson from "jobs/commands.ts" to descendants
expose-test scriptedCandidates, ScriptedCommit, ScriptedCandidates from "helpers/candidates.ts" to descendants
expose-test scratchCandidateReplies from "helpers/scratch-candidate-replies.ts" to descendants

// Constructed committed-input witnesses for focused child query regressions.
// Signature companions are the selected reading records exposed above and
// CommittedRun/CommittedLine received from projections (never writer ports).
expose-sub CommittedRun, CommittedLine from projections to descendants
expose-test at, constructedRun, constructedRecord, forecast, runId, hash, item, obligation, registered, requirement, reviews, Line from "helpers/constructed.ts" to descendants
// Exact shared capability query fixtures; no private projector or writable authority.
expose-test capabilityProjectionLines, capabilityContractRun from "helpers/capability-projection.ts" to descendants

// Selected pure replay and fixture contracts for child-owned reading witnesses.
expose-sub decideCheckFindingChange, applyCheckFindingEvent, emptyCheckFindingState, CheckFindingCommand, CheckFindingEvent, CheckFindingChange, CheckFindingApplied, CheckFindingDecisionInput, CheckFindingReportInput, checkFindingCommandSchema, checkFindingEventSchema, checkFindingDecisionInputSchema, checkFindingReportInputSchema from check-findings to descendants
