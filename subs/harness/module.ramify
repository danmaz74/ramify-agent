expose-src runPolicyVersion from "run/policy.ts" to descendants
expose-src SnapshotId from "run/records.ts" to descendants
expose-src ContinueReason, DegradeRelation, EntryAssignments, ForkRelation, Invocation, InvocationOutcome, InvocationWork, LineEventSummary, MeasurementSnapshot, ModuleProposal, ReplaceRelation, RequestRelation, ReviewKind, RunPolicy, RunRecord, ScopeComponent, ScopeSize, SessionFinishReason, SessionId, SessionPoint, continueReasonSchema, degradeRelationSchema, entryAssignmentsSchema, forkRelationSchema, gateAttemptSchema, gateAuditOutcomeSchema, invocationOutcomeSchema, invocationSchema, invocationWorkSchema, lineEventSummarySchema, manualRunRecordSchema, measurementSnapshotSchema, moduleProposalSchema, replaceRelationSchema, requestRelationSchema, reviewKindSchema, runLayout, runPolicySchema, runRecordSchema, scopeComponentSchema, scopeSizeSchema, runSessionFinishReasonSchema, sessionPointSchema from "run/records.ts" to descendants
