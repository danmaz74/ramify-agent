ramify 1
module scenarios

// Acceptance scenarios as pure functions: plan extraction, the form rules of
// the initial analysis, records and their numbering, the state reducer and
// feature rendering. The project's own Cucumber configuration runs them as
// checks of its committed audit definition. The Gherkin parser stays behind
// this boundary. Every named type a signature mentions is exposed
// beside the symbol, so the parent can name what it receives.
expose-src extractPlanScenarios, extractDocumentScenarios, descriptiveSlug, ScenarioIdentityContract, PlanScenario, planScenarioSchema, PlanScenarioLimitation, planScenarioLimitationSchema, PlanScenarioExtraction, planScenarioExtractionSchema from "extraction.ts" to parent
expose-src validateScenarioForm, scenarioFormRules, ScenarioFormRule, ScenarioFormResult, ScenarioFormSubmission, scenarioFormSubmissionSchema, ScenarioSubmission, scenarioSubmissionSchema, IntegrationScenarioSubmission, integrationScenarioSubmissionSchema, scenarioOriginSubmissionSchema, ScenarioElementRef, scenarioElementRefSchema, ScenarioFormEntry, ScenarioViewNames, NonBehavioralAcceptance, nonBehavioralAcceptanceSchema, ScenarioFormEvidence, ScenarioWarning, ScenarioWarningKind, AcceptedScenarioForm, FormScenario, FormIntegration, ScenarioFormWarningKind, descriptiveScenarioSubmissionSchema, descriptiveIntegrationScenarioSubmissionSchema, descriptiveScenarioFormSubmissionSchema, DescriptiveScenarioFormSubmission, normalizeDescriptiveScenarioForm from "form.ts" to parent
expose-src assignScenarioIds, AssignedScenarios, ScenarioIdContext, ScenarioModule, ScenarioRecord, scenarioRecordSchema, ScenarioId, scenarioIdSchema, scenarioSourceHash, scenarioIdOf, lowestCommonAncestor, featureDirectoryOf from "records.ts" to parent
expose-src ScenarioState, scenarioStateSchema, ScenarioEvent, scenarioEventTypes, ScenarioStates, initialScenarioStates, applyScenarioEvent, boundState, reportedState, reduceScenarioStates, countScenarioStates, carriesPendingTag from "states.ts" to parent
expose-src renderFeatureFiles, FeatureRenderingRun, RenderedFeatureFile, pendingTag, identityTagOf, scenarioIdOfTag from "rendering.ts" to parent
