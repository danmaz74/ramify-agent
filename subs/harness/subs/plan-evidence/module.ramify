ramify 1
module plan-evidence

// Captured source identity, the element catalog and its package creator
// belong to this child. The harness receives these contracts and remains
// the only durable writer.
expose-src * from "interfaces/contracts.ts" to parent
expose-src * from "interfaces/catalog.ts" to parent
expose-src discoverDocuments, nodeDocumentReader, DocumentReader, DiscoveredDocuments, DocumentDiscoveryOptions, OutsideDocumentReference, UnreadableDocumentReference from "discovery.ts" to parent
expose-src DocumentManifest from "interfaces/contracts.ts" to parent
expose-src acceptElements from "interfaces/catalog.ts" to parent
expose-src submittedElementSchema from "interfaces/catalog.ts" to parent
expose-src ElementCatalog from "interfaces/catalog.ts" to parent
expose-src ElementKind from "interfaces/catalog.ts" to parent
expose-src ElementReferenceList from "interfaces/catalog.ts" to parent
expose-src createPackage from "interfaces/catalog.ts" to parent
expose-src elementRewriteSchema from "interfaces/catalog.ts" to parent
expose-src resolveCitations from "interfaces/catalog.ts" to parent
expose-src reviseCatalog from "interfaces/catalog.ts" to parent
expose-src elementCatalogSchema from "interfaces/catalog.ts" to parent
expose-src elementIdSchema from "interfaces/catalog.ts" to parent
expose-src openElementCatalog from "interfaces/catalog.ts" to parent
expose-src serializeElementCatalog from "interfaces/catalog.ts" to parent
expose-src PackageCitation from "interfaces/catalog.ts" to parent
expose-src PackageDeviation from "interfaces/catalog.ts" to parent
expose-src documentManifestSchema from "interfaces/contracts.ts" to parent
expose-src CatalogElement from "interfaces/catalog.ts" to parent
expose-src packageCitationSchema from "interfaces/catalog.ts" to parent
expose-src verifyDocumentBytes from "interfaces/contracts.ts" to parent
expose-src ElementAcceptance from "interfaces/catalog.ts" to parent
expose-src PackageRequest from "interfaces/catalog.ts" to parent
expose-src Package from "interfaces/catalog.ts" to parent
expose-src CatalogRevision from "interfaces/catalog.ts" to parent
expose-src catalogElementSchema from "interfaces/catalog.ts" to parent
expose-src CapturedDocument from "interfaces/contracts.ts" to parent
expose-src ElementRewrite from "interfaces/catalog.ts" to parent
expose-src capturedDocumentSchema from "interfaces/contracts.ts" to parent
expose-src SubmittedElement from "interfaces/catalog.ts" to parent
