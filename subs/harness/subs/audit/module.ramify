ramify 1
module audit

// The audit library and its evidence model stay behind this boundary. The
// parent receives the committed configured audit, its harness result with
// each nested project and the discovery outcome, and the durable
// workspace-ownership callback contract with its nested invocation receipt.
// No ramify-audit type crosses.
expose-src AuditCheckExecutionOptions, AuditWorkspaceOwnershipRecorder, IntendedAuditWorkspace, AuditInvocationReceipt, AuditInvocationProject, createConfiguredAudit, ConfiguredAuditPort, ConfiguredAuditInput, ConfiguredAuditMode, ConfiguredAuditReuse, ConfiguredProjectResult, ConfiguredCountBucket, ConfiguredNestedDiscovery, CommittedAuditConfiguration, ConfiguredAuditResult, ConfiguredFullAuditResult, configuredFullRecovery, configuredAuditInstability, configuredAuditInstabilityObservations, readCommittedAuditConfiguration, sameAuditPolicy from "check-execution.ts" to parent
expose-src testLockedRunner, TestLockOwner, TestLockHooks, TestLockOverride from "test-lock.ts" to parent
expose-src dispatchHarnessCommand from "focused-check.ts" to parent
