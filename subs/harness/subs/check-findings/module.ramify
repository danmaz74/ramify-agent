ramify 1
module check-findings

// CheckFindings as pure functions: the identity of an issue across reports,
// the decisions that may change it, the state replay derives and the views
// a query selects. The harness binds every reference it passes in and
// commits the returned events through its ledger. The contract file names
// every type a signature below mentions, so the parent can name what it
// receives.
expose-src * from "interfaces/check-findings.ts" to parent
expose-src decideCheckFindingChange from "decide.ts" to parent
expose-src applyCheckFindingEvent, replayCheckFindingEvents, emptyCheckFindingState from "replay.ts" to parent
expose-src selectCheckFindings from "queries.ts" to parent
expose-src CheckFindingCommand from "interfaces/check-findings.ts" to parent
expose-src CheckFindingEntry from "interfaces/check-findings.ts" to parent
expose-src CheckFindingState from "interfaces/check-findings.ts" to parent
expose-src CheckFindingDecision from "interfaces/check-findings.ts" to parent
expose-src CheckFindingAt from "interfaces/check-findings.ts" to parent
expose-src CheckFindingId from "interfaces/check-findings.ts" to parent
expose-src CheckFindingQueryInput from "interfaces/check-findings.ts" to parent
expose-src CheckFindingSelection from "interfaces/check-findings.ts" to parent
expose-src CheckFindingSummary from "interfaces/check-findings.ts" to parent
expose-src CheckFindingEvent from "interfaces/check-findings.ts" to parent
