{
  "registry": [
    {
      "schema": "ramify-agent.capability/1",
      "capability": "preview-proposed-revision-chain",
      "revision": 1,
      "behavior": "Publish reviews.preview as one new tRPC mutation using the existing chain schema and vocabulary. Consume protocol-independent preview behavior from Review Validation, preserve all existing reviews, and establish the composed result through the assembled typed client with real providers, including invalid untyped input. Review declarations and actual imports for resolver reuse, update affected module descriptions and READMEs, and retain all declared project checks.",
      "owner": "collection-review/workspace/reviews",
      "origin": "entry",
      "decision": null,
      "consumers": []
    },
    {
      "schema": "ramify-agent.capability/1",
      "capability": "inspect-editable-revision-snapshot",
      "revision": 1,
      "behavior": "Make every successful direct catalog inspection an independently mutable working report for both all and latest scopes. Detach the returned chain array and revision objects from stored records and other reports, isolate predecessor and finding arrays, and verify this directly without serialization while preserving inspection facts, observations and mutable public types.",
      "owner": "collection-review/workspace/catalog/core",
      "origin": "entry",
      "decision": null,
      "consumers": []
    }
  ],
